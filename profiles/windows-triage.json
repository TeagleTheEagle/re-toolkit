{
  "profile": "deep",
  "grep": [
    "password",
    "passwd",
    "api_key",
    "apikey",
    "secret",
    "token",
    "BEGIN PRIVATE KEY",
    "BEGIN RSA PRIVATE KEY",
    "BEGIN OPENSSH PRIVATE KEY",
    "http://",
    "https://",
    "ftp://",
    "wss://",
    "cmd.exe",
    "powershell",
    "CreateProcess",
    "WinExec",
    "ShellExecute",
    "VirtualAlloc",
    "WriteProcessMemory",
    "LoadLibrary",
    "GetProcAddress",
    "IsDebuggerPresent",
    "CheckRemoteDebuggerPresent",
    "OutputDebugString",
    "CurrentVersion\\\\Run",
    "schtasks",
    ".onion"
  ],
  "extra": ["inspect-binary-hardening", "inspect-pe-imports", "inspect-pe-resources"],
  "timeoutSeconds": 1800,
  "decompileAll": true,
  "allowExec": false,
  "reportFormats": "json,md"
}
